# Email is sent only when the CLI receives --notify or --notify-all.
SMTP_USER=your-account@example.com
SMTP_PASS=your-app-password
RECEIVER_EMAIL=destination@example.com
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Optional private enrichment. Keep the real profile outside Git.
HIRING_INTELLIGENCE_ENABLED=false
MAX_HIRING_LOOKUPS=10
CANDIDATE_PROFILE_FILE=candidate_profile.local.json

# Optional runtime settings.
OUTPUT_DIR=.
LOG_LEVEL=WARNING
# Set to true only if you intentionally want country-restricted results outside Europe.
INCLUDE_UNLIKELY_LOCATIONS=false
