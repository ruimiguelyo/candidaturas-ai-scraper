# === Estágio Radar PT - Configuração de Alertas ===
# Copia este ficheiro para .env e preenche os canais que quiseres usar.

# --- 1. Mobile Push Instantâneo (ntfy.sh - GRÁTIS, sem conta!) ---
# Instala a app ntfy no telemóvel e subscreve um tópico secreto único.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh

# --- 2. Discord Webhook (Alertas instantâneos por canal) ---
DISCORD_WEBHOOK_URL=

# --- 3. Telegram Bot (Alertas instantâneos no telemóvel) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- 4. Email SMTP (Digest HTML limpo, sem spam) ---
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
RECEIVER_EMAIL=

# --- 5. Opções do Radar ---
RADAR_DB_PATH=data/radar.db
COMPANY_CACHE_PATH=data/company_cache.json
RADAR_OUTPUT_DIR=output
RADAR_HIDE_CONSULTANCIES=false
NOTIFY_SKIP_CONSULTANCIES=true
RADAR_MIN_SCORE=0
